class PSHS_Galaxy:
    def __init__(self, planet):
        self.__planet = planet

    def get_planet(self):
        return self.__planet

    def set_planet(self, planet):
        self.__planet = planet

class Nationalities(PSHS_Galaxy):
    def __init__ (self, planet, country):
        super().__init__(planet)
        self.__country = country

    def get_country(self):
        return self.__country
    
    def set_country(self, country):
        self.__country = country

class Alien(PSHS_Galaxy):
    def __init__ (self, planet):
        super().__init__(planet)

class Filipino(Nationalities):
    def __init__(self, planet, country, language):
        super().__init__(planet, country)
        self.__language = language

    def get_language(self):
        return self.__language

    def set_language(self, language):
        self.__language = language

